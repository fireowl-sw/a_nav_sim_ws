<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
   <xacro:include filename="$(find fishbot_description)/urdf/common_inertia.xacro" />
    <xacro:macro name="laser_xacro" params="xyz laser_radius laser_length laser_mass cylinder_radius cylinder_length cylinder_mass laser_color_rgba='0.0 0.0 0.0 0.8' laser_gazebo_material='Gazebo/Black' cylinder_color_rgba='0.0 0.0 0.0 0.8' cylinder_gazebo_material='Gazebo/Black'">
        <gazebo reference="laser_cylinder_link">
            <material>${cylinder_gazebo_material}</material>
        </gazebo>
        <gazebo reference="laser_link">
            <material>${laser_gazebo_material}</material>
        </gazebo>

        <!-- ============雷达支撑杆================ -->
        <link name="laser_cylinder_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${cylinder_length}" radius="${cylinder_radius}" />
                </geometry>
                <material name="cylinder_color">
                    <color rgba="${cylinder_color_rgba}" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${cylinder_length}" radius="${cylinder_radius}" />
                </geometry>
                <material name="cylinder_color">
                    <color rgba="${cylinder_color_rgba}" />
                </material>
            </collision>
            <xacro:cylinder_inertia m="${cylinder_mass}" r="${cylinder_radius}" h="${cylinder_length}" />
        </link>



        <joint name="laser_cylinder_joint" type="fixed">
            <parent link="base_link" />
            <child link="laser_cylinder_link" />
            <origin xyz="${xyz}" />
        </joint>
        <!-- ============雷达================ -->
        <link name="laser_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${laser_length}" radius="${laser_radius}" />
                </geometry>
                <material name="laser_color">
                    <color rgba="${laser_color_rgba}" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${laser_length}" radius="${laser_radius}" />
                </geometry>
                <material name="laser_color">
                    <color rgba="${laser_color_rgba}" />
                </material>
            </collision>
            <xacro:cylinder_inertia m="${laser_mass}" r="${laser_radius}" h="${laser_length}" />
        </link>

        <joint name="laser_joint" type="fixed">
            <parent link="laser_cylinder_link" />
            <child link="laser_link" />
            <origin xyz="0 0 0.05" />
        </joint>

    </xacro:macro>

</robot>
